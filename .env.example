# Local development defaults. Never commit real values.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
TVS_DATA_KEY=replace-with-32-random-bytes-encoded-as-urlsafe-base64
TVS_SETUP_TOKEN=replace-with-a-separate-random-setup-token
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Production only. Leave unset locally to use SQLite.
DATABASE_URL=postgresql://user:password@host:5432/database
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
